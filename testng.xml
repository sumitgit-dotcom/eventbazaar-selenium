<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="EventBazaar Cross-Browser Suite" parallel="none" thread-count="1">

    <!-- 1st Run: Chrome -->
    <test name="Chrome Test">
        <parameter name="browser" value="chrome"/>
        <classes>
            <class name="com.eventbazaar.runners.TestRunner"/>
        </classes>
    </test>

    <!-- 2nd Run: Firefox -->
    <test name="Firefox Test">
        <parameter name="browser" value="firefox"/>
        <classes>
            <class name="com.eventbazaar.runners.TestRunner"/>
        </classes>
    </test>

    <!-- 3rd Run: Edge -->
    <test name="Edge Test">
        <parameter name="browser" value="edge"/>
        <classes>
            <class name="com.eventbazaar.runners.TestRunner"/>
        </classes>
    </test>

</suite>